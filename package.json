{
  "name": "asass",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @asass/web --filter @asass/admin dev",
    "dev:web": "pnpm --filter @asass/web dev",
    "dev:admin": "pnpm --filter @asass/admin dev",
    "dev:server": "cd server && go run ./cmd/api",
    "build": "pnpm -r --if-present build && pnpm run build:server",
    "build:web": "pnpm --filter @asass/web build",
    "build:admin": "pnpm --filter @asass/admin build",
    "build:server": "cd server && go build ./cmd/api",
    "lint": "pnpm -r --if-present lint",
    "lint:web": "pnpm --filter @asass/web lint",
    "lint:admin": "pnpm --filter @asass/admin lint",
    "preview:web": "pnpm --filter @asass/web preview",
    "preview:admin": "pnpm --filter @asass/admin preview",
    "test": "pnpm -r --if-present test && pnpm run test:server",
    "test:server": "cd server && go test ./..."
  },
  "keywords": [],
  "author": "Asriel",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0"
}